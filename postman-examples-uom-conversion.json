{
  "info": {
    "name": "i-max POS - UOM Conversion Examples",
    "description": "Postman examples for Unit of Measure (UOM) conversion feature — ကျင်း/မူး Myanmar unit support",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "uom-conversion-api"
  },
  "item": [
    {
      "name": "1. Create Inventory with UOM (Sand - သဲ)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{jwt_token}}", "type": "text" }
        ],
        "body": {
          "mode": "formdata",
          "formdata": [
            { "key": "productName", "value": "သဲ (Sand)", "type": "text" },
            { "key": "productCode", "value": "SAND001", "type": "text" },
            { "key": "category", "value": "Construction Materials", "type": "text" },
            { "key": "buyingPrice", "value": "5000", "type": "text" },
            { "key": "sellingPrice", "value": "7000", "type": "text" },
            { "key": "unitOfMeasure", "value": "ကျင်း", "type": "text" },
            { "key": "uomConversions", "value": "[{\"unit\":\"မူး\",\"factor\":10,\"isDefaultSellingUnit\":true}]", "type": "text" },
            { "key": "reorderPoint", "value": "10", "type": "text" },
            { "key": "reorderQuantity", "value": "50", "type": "text" },
            { "key": "status", "value": "active", "type": "text" }
          ]
        },
        "url": {
          "raw": "{{base_url}}/inventory",
          "host": ["{{base_url}}"],
          "path": ["inventory"]
        }
      }
    },
    {
      "name": "2. Create Inventory with UOM (Cement - အုတ်/အင်္ဂါ)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{jwt_token}}", "type": "text" }
        ],
        "body": {
          "mode": "formdata",
          "formdata": [
            { "key": "productName", "value": "အင်္ဂါခဲ (Cement Brick)", "type": "text" },
            { "key": "productCode", "value": "BRICK001", "type": "text" },
            { "key": "category", "value": "Construction Materials", "type": "text" },
            { "key": "buyingPrice", "value": "300", "type": "text" },
            { "key": "sellingPrice", "value": "500", "type": "text" },
            { "key": "unitOfMeasure", "value": "အုတ်", "type": "text" },
            { "key": "uomConversions", "value": "[{\"unit\":\"ပါတ်\",\"factor\":100,\"isDefaultSellingUnit\":true},{\"unit\":\"ထုပ်\",\"factor\":500}]", "type": "text" },
            { "key": "reorderPoint", "value": "500", "type": "text" },
            { "key": "reorderQuantity", "value": "5000", "type": "text" },
            { "key": "status", "value": "active", "type": "text" }
          ]
        },
        "url": {
          "raw": "{{base_url}}/inventory",
          "host": ["{{base_url}}"],
          "path": ["inventory"]
        }
      }
    },
    {
      "name": "3. Create Inventory with UOM (Water - English units)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{jwt_token}}", "type": "text" }
        ],
        "body": {
          "mode": "formdata",
          "formdata": [
            { "key": "productName", "value": "Shwe Pyi Tan Drinking Water", "type": "text" },
            { "key": "productCode", "value": "WATERGAL", "type": "text" },
            { "key": "category", "value": "Beverages", "type": "text" },
            { "key": "buyingPrice", "value": "200", "type": "text" },
            { "key": "sellingPrice", "value": "350", "type": "text" },
            { "key": "unitOfMeasure", "value": "gallon", "type": "text" },
            { "key": "uomConversions", "value": "[{\"unit\":\"liter\",\"factor\":3.78,\"isDefaultSellingUnit\":true},{\"unit\":\"bottle(500ml)\",\"factor\":7.56}]", "type": "text" },
            { "key": "status", "value": "active", "type": "text" }
          ]
        },
        "url": {
          "raw": "{{base_url}}/inventory",
          "host": ["{{base_url}}"],
          "path": ["inventory"]
        }
      }
    },
    {
      "name": "4. Create Order (Sell Sand in မူး - Auto Convert)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{jwt_token}}", "type": "text" },
          { "key": "Content-Type", "value": "application/json", "type": "text" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"storefrontId\": \"YOUR_STOREFRONT_ID\",\n  \"ordersProducts\": [\n    {\n      \"inventoryId\": \"YOUR_SAND_INVENTORY_ID\",\n      \"unit\": \"မူး\",\n      \"quantity\": 5\n    }\n  ],\n  \"paidAmount\": 3500\n}",
          "options": {
            "raw": { "language": "json" }
          }
        },
        "url": {
          "raw": "{{base_url}}/order",
          "host": ["{{base_url}}"],
          "path": ["order"]
        }
      }
    },
    {
      "name": "5. Create Order (Sell Sand in ကျင်း - No Conversion)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{jwt_token}}", "type": "text" },
          { "key": "Content-Type", "value": "application/json", "type": "text" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"storefrontId\": \"YOUR_STOREFRONT_ID\",\n  \"ordersProducts\": [\n    {\n      \"inventoryId\": \"YOUR_SAND_INVENTORY_ID\",\n      \"quantity\": 2\n    }\n  ],\n  \"paidAmount\": 14000\n}",
          "options": {
            "raw": { "language": "json" }
          }
        },
        "url": {
          "raw": "{{base_url}}/order",
          "host": ["{{base_url}}"],
          "path": ["order"]
        }
      }
    },
    {
      "name": "6. Get Storefront Inventory (with quantityByUnit)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{jwt_token}}", "type": "text" }
        ],
        "url": {
          "raw": "{{base_url}}/storefront-inventory?storefrontId=YOUR_STOREFRONT_ID",
          "host": ["{{base_url}}"],
          "path": ["storefront-inventory"],
          "query": [
            { "key": "storefrontId", "value": "YOUR_STOREFRONT_ID" }
          ]
        }
      }
    },
    {
      "name": "7. Update Inventory UOM (Add/Change Conversions)",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Authorization", "value": "Bearer {{jwt_token}}", "type": "text" },
          { "key": "Content-Type", "value": "application/json", "type": "text" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"uomConversions\": [\n    { \"unit\": \"မူး\", \"factor\": 10, \"isDefaultSellingUnit\": true },\n    { \"unit\": \"စိတ်\", \"factor\": 5 }\n  ]\n}",
          "options": {
            "raw": { "language": "json" }
          }
        },
        "url": {
          "raw": "{{base_url}}/inventory/YOUR_INVENTORY_ID",
          "host": ["{{base_url}}"],
          "path": ["inventory", "YOUR_INVENTORY_ID"],
          "variable": [
            { "key": "id", "value": "YOUR_INVENTORY_ID" }
          ]
        }
      }
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:5000/api/v1",
      "type": "string"
    },
    {
      "key": "jwt_token",
      "value": "your-jwt-token-here",
      "type": "string"
    }
  ]
}
