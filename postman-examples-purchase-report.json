{
  "info": {
    "name": "i-max POS - Purchase Report API",
    "description": "Postman collection for Purchase Order (PO) reports — similar to sale reports",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "purchase-report-api"
  },
  "item": [
    {
      "name": "1. Overall PO Report",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{jwt_token}}", "type": "text" }
        ],
        "url": {
          "raw": "{{base_url}}/purchase-report?page=1&limit=10&status=completed&startDate=2026-01-01&endDate=2026-12-31",
          "host": ["{{base_url}}"],
          "path": ["purchase-report"],
          "query": [
            { "key": "page", "value": "1" },
            { "key": "limit", "value": "10" },
            { "key": "status", "value": "completed", "description": "pending | confirmed | arrived | completed | cancelled" },
            { "key": "supplierId", "value": "", "description": "Filter by supplier (optional)" },
            { "key": "startDate", "value": "2026-01-01" },
            { "key": "endDate", "value": "2026-12-31" }
          ]
        }
      }
    },
    {
      "name": "2. Purchase Product Report",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{jwt_token}}", "type": "text" }
        ],
        "url": {
          "raw": "{{base_url}}/purchase-report/products?page=1&limit=10&sortBy=totalOrdered&sortOrder=desc",
          "host": ["{{base_url}}"],
          "path": ["purchase-report", "products"],
          "query": [
            { "key": "page", "value": "1" },
            { "key": "limit", "value": "10" },
            { "key": "sortBy", "value": "totalOrdered", "description": "totalOrdered | totalReceived | totalAmount" },
            { "key": "sortOrder", "value": "desc" },
            { "key": "supplierId", "value": "", "description": "Filter by supplier (optional)" },
            { "key": "category", "value": "", "description": "Filter by category (optional)" }
          ]
        }
      }
    },
    {
      "name": "3. Purchase Supplier Report",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{jwt_token}}", "type": "text" }
        ],
        "url": {
          "raw": "{{base_url}}/purchase-report/suppliers?page=1&limit=10&sortBy=totalAmount&sortOrder=desc",
          "host": ["{{base_url}}"],
          "path": ["purchase-report", "suppliers"],
          "query": [
            { "key": "page", "value": "1" },
            { "key": "limit", "value": "10" },
            { "key": "sortBy", "value": "totalAmount", "description": "totalAmount | totalPOs | totalOrdered" },
            { "key": "sortOrder", "value": "desc" }
          ]
        }
      }
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:5000/api/v1",
      "type": "string"
    },
    {
      "key": "jwt_token",
      "value": "your-jwt-token-here",
      "type": "string"
    }
  ]
}
