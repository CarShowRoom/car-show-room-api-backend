{
  "info": {
    "name": "i-max POS - Shop Settings API",
    "description": "Postman collection for Shop Settings management with Cloudflare R2 image upload",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "shop-settings-api",
    "_postman_exported_using": "Postman/10.0.0"
  },
  "item": [
    {
      "name": "Shop Settings",
      "item": [
        {
          "name": "Create or Update Shop Settings",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"shopName\": \"My Super Shop\",\n  \"address\": \"123 Main Street, Yangon, Myanmar\",\n  \"phoneNumber\": \"+959123456789\",\n  \"email\": \"contact@mysupershop.com\",\n  \"taxId\": \"MM-123456789\",\n  \"currency\": \"MMK\",\n  \"taxRate\": 5,\n  \"businessHours\": {\n    \"monday\": { \"open\": \"09:00\", \"close\": \"21:00\", \"closed\": false },\n    \"tuesday\": { \"open\": \"09:00\", \"close\": \"21:00\", \"closed\": false },\n    \"wednesday\": { \"open\": \"09:00\", \"close\": \"21:00\", \"closed\": false },\n    \"thursday\": { \"open\": \"09:00\", \"close\": \"21:00\", \"closed\": false },\n    \"friday\": { \"open\": \"09:00\", \"close\": \"21:00\", \"closed\": false },\n    \"saturday\": { \"open\": \"09:00\", \"close\": \"22:00\", \"closed\": false },\n    \"sunday\": { \"open\": \"10:00\", \"close\": \"20:00\", \"closed\": false }\n  },\n  \"socialMedia\": {\n    \"facebook\": \"https://facebook.com/mysupershop\",\n    \"instagram\": \"https://instagram.com/mysupershop\",\n    \"website\": \"https://mysupershop.com\"\n  },\n  \"isActive\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/shop-settings",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "shop-settings"]
            }
          },
          "response": []
        },
        {
          "name": "Get Current Shop Settings",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/shop-settings",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "shop-settings"]
            }
          },
          "response": []
        },
        {
          "name": "Upload Shop Logo",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "logo",
                  "type": "file",
                  "src": "/path/to/your/logo.png",
                  "description": "Shop logo image (JPEG, PNG, WebP - Max 5MB)"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/api/v1/shop-settings/logo",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "shop-settings", "logo"]
            }
          },
          "response": []
        },
        {
          "name": "Delete Shop Logo",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/shop-settings/logo",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "shop-settings", "logo"]
            }
          },
          "response": []
        },
        {
          "name": "Get Shop Settings History",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/shop-settings/history?page=1&limit=10&sortBy=updatedAt&sortOrder=desc",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "shop-settings", "history"],
              "query": [
                {
                  "key": "page",
                  "value": "1",
                  "description": "Page number for pagination"
                },
                {
                  "key": "limit",
                  "value": "10",
                  "description": "Number of items per page"
                },
                {
                  "key": "sortBy",
                  "value": "updatedAt",
                  "description": "Sort field (createdAt, updatedAt, shopName)"
                },
                {
                  "key": "sortOrder",
                  "value": "desc",
                  "description": "Sort order (asc, desc)"
                }
              ]
            }
          },
          "response": []
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000",
      "type": "string",
      "description": "Your API base URL"
    },
    {
      "key": "jwt_token",
      "value": "your_jwt_token_here",
      "type": "string",
      "description": "JWT token for authentication"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// This script runs before each request",
          "// You can add any global pre-request logic here",
          ""
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// This script runs after each response",
          "// You can add global tests here",
          ""
        ]
      }
    }
  ]
}
