{
  "info": {
    "name": "i-max POS - AI Chatbot",
    "description": "Gemini AI Chatbot with Tool Calling — POS-specific assistant (owner only). Ask about sales, products, stock, expenses. Conversation history: last 10 messages only.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "chatbot-api"
  },
  "item": [
    {
      "name": "1. Chat (Ask Question)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{jwt_token}}", "type": "text" },
          { "key": "Content-Type", "value": "application/json", "type": "text" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"message\": \"မင်္ဂလာပါ\"\n}",
          "options": {
            "raw": { "language": "json" }
          }
        },
        "url": {
          "raw": "{{base_url}}/chatbot",
          "host": ["{{base_url}}"],
          "path": ["chatbot"]
        }
      }
    },
