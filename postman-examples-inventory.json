{
  "info": {
    "name": "i-max POS - Inventory API",
    "description": "Complete Postman collection for Inventory management with images (Cloudflare R2) and wholesale pricing",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "inventory-api"
  },
  "item": [
    {
      "name": "Create Inventory (with images + wholesale prices)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{jwt_token}}", "type": "text" }
        ],
        "body": {
          "mode": "formdata",
          "formdata": [
            { "key": "productName", "value": "Coca Cola 500ml Bottle", "type": "text" },
            { "key": "productCode", "value": "COKE500ML", "type": "text" },
            { "key": "saleCode", "value": "FB-COKE500", "type": "text" },
            { "key": "category", "value": "Beverages", "type": "text" },
            { "key": "subCategory", "value": "Soft Drinks", "type": "text" },
            { "key": "brand", "value": "Coca Cola", "type": "text" },
            { "key": "description", "value": "Refreshing carbonated soft drink", "type": "text" },
            { "key": "buyingPrice", "value": "50", "type": "text" },
            { "key": "sellingPrice", "value": "75", "type": "text" },
            { "key": "unitOfMeasure", "value": "piece", "type": "text" },
            { "key": "reorderPoint", "value": "100", "type": "text" },
            { "key": "reorderQuantity", "value": "500", "type": "text" },
            { "key": "taxRate", "value": "5", "type": "text" },
            { "key": "status", "value": "active", "type": "text" },
            { "key": "tags", "value": "beverage,soft-drink,carbonated", "type": "text" },
            { "key": "wholesalePrices", "value": "[{\"quantity\":100,\"price\":65},{\"quantity\":500,\"price\":60},{\"quantity\":1000,\"price\":55}]", "type": "text" },
            { "key": "images", "type": "file", "src": "" }
          ]
        },
        "url": {
          "raw": "{{base_url}}/inventory",
          "host": ["{{base_url}}"],
          "path": ["inventory"]
        }
      }
    },
    {
      "name": "Create Inventory (unit-based wholesale, UOM conversion)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{jwt_token}}", "type": "text" }
        ],
        "body": {
          "mode": "formdata",
          "formdata": [
            { "key": "productName", "value": "Royal D Engine Oil 20W-50", "type": "text" },
            { "key": "productCode", "value": "RD2050", "type": "text" },
            { "key": "category", "value": "Engine Oil", "type": "text" },
            { "key": "subCategory", "value": "4-Stroke Oil", "type": "text" },
            { "key": "brand", "value": "Royal D", "type": "text" },
            { "key": "description", "value": "High performance 4-stroke engine oil", "type": "text" },
            { "key": "buyingPrice", "value": "4000", "type": "text" },
            { "key": "sellingPrice", "value": "5500", "type": "text" },
            { "key": "unitOfMeasure", "value": "ဘူး", "type": "text" },
            { "key": "reorderPoint", "value": "50", "type": "text" },
            { "key": "reorderQuantity", "value": "200", "type": "text" },
            { "key": "status", "value": "active", "type": "text" },
            { "key": "tags", "value": "engine-oil,royal-d,4-stroke", "type": "text" },
            { "key": "uomConversions", "value": "[{\"unit\":\"ပုံး\",\"factor\":24,\"isDefaultSellingUnit\":false}]", "type": "text" },
            { "key": "wholesalePrices", "value": "[{\"quantity\":12,\"price\":5200},{\"quantity\":24,\"price\":5000},{\"quantity\":50,\"price\":4800},{\"unit\":\"ပုံး\",\"quantity\":1,\"price\":95000},{\"unit\":\"ပုံး\",\"quantity\":5,\"price\":90000}]", "type": "text" },
            { "key": "images", "type": "file", "src": "" }
          ]
        },
        "url": {
          "raw": "{{base_url}}/inventory",
          "host": ["{{base_url}}"],
          "path": ["inventory"]
        }
      }
    },
    {
      "name": "Create Inventory (minimal fields)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{jwt_token}}", "type": "text" }
        ],
        "body": {
          "mode": "formdata",
          "formdata": [
            { "key": "productName", "value": "Rice 5kg Bag", "type": "text" },
            { "key": "productCode", "value": "RICE5KG", "type": "text" },
            { "key": "category", "value": "Food", "type": "text" },
            { "key": "buyingPrice", "value": "5000", "type": "text" },
            { "key": "sellingPrice", "value": "6500", "type": "text" },
            { "key": "unitOfMeasure", "value": "piece", "type": "text" }
          ]
        },
        "url": {
          "raw": "{{base_url}}/inventory",
          "host": ["{{base_url}}"],
          "path": ["inventory"]
        }
      }
    },
    {
      "name": "Get All Inventory",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{jwt_token}}", "type": "text" }
        ],
        "url": {
          "raw": "{{base_url}}/inventory?page=1&limit=10&category=Beverages&status=active&search=Coca&sortBy=createdAt&sortOrder=desc",
          "host": ["{{base_url}}"],
          "path": ["inventory"],
          "query": [
            { "key": "page", "value": "1" },
            { "key": "limit", "value": "10" },
            { "key": "category", "value": "Beverages" },
            { "key": "status", "value": "active" },
            { "key": "search", "value": "Coca" },
            { "key": "sortBy", "value": "createdAt" },
            { "key": "sortOrder", "value": "desc" }
          ]
        }
      }
    },
    {
      "name": "Get Inventory By ID",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{jwt_token}}", "type": "text" }
        ],
        "url": {
          "raw": "{{base_url}}/inventory/664c9f1a...",
          "host": ["{{base_url}}"],
          "path": ["inventory", "664c9f1a..."],
          "variable": [
            { "key": "id", "value": "664c9f1a..." }
          ]
        }
      }
    },
    {
      "name": "Update Inventory",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Authorization", "value": "Bearer {{jwt_token}}", "type": "text" },
          { "key": "Content-Type", "value": "application/json", "type": "text" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"productName\": \"Coca Cola 500ml Pet Bottle\",\n  \"sellingPrice\": 80,\n  \"wholesalePrices\": [\n    { \"quantity\": 50, \"price\": 70 },\n    { \"quantity\": 200, \"price\": 65 },\n    { \"quantity\": 500, \"price\": 60 },\n    { \"unit\": \"case\", \"quantity\": 1, \"price\": 700 },\n    { \"unit\": \"case\", \"quantity\": 10, \"price\": 650 }\n  ]\n}",
          "options": {
            "raw": { "language": "json" }
          }
        },
        "url": {
          "raw": "{{base_url}}/inventory/664c9f1a...",
          "host": ["{{base_url}}"],
          "path": ["inventory", "664c9f1a..."],
          "variable": [
            { "key": "id", "value": "664c9f1a..." }
          ]
        }
      }
    },
    {
      "name": "Upload Images to Existing Product",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{jwt_token}}", "type": "text" }
        ],
        "body": {
          "mode": "formdata",
          "formdata": [
            { "key": "images", "type": "file", "src": "" }
          ]
        },
        "url": {
          "raw": "{{base_url}}/inventory/664c9f1a.../images",
          "host": ["{{base_url}}"],
          "path": ["inventory", "664c9f1a...", "images"],
          "variable": [
            { "key": "id", "value": "664c9f1a..." }
          ]
        }
      }
    },
    {
      "name": "Delete Image from Product",
      "request": {
        "method": "DELETE",
        "header": [
          { "key": "Authorization", "value": "Bearer {{jwt_token}}", "type": "text" }
        ],
        "url": {
          "raw": "{{base_url}}/inventory/664c9f1a.../images/664c9f1b...",
          "host": ["{{base_url}}"],
          "path": ["inventory", "664c9f1a...", "images", "664c9f1b..."],
          "variable": [
            { "key": "id", "value": "664c9f1a..." },
            { "key": "imageId", "value": "664c9f1b..." }
          ]
        }
      }
    },
    {
      "name": "Set Primary Image",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Authorization", "value": "Bearer {{jwt_token}}", "type": "text" }
        ],
        "url": {
          "raw": "{{base_url}}/inventory/664c9f1a.../images/664c9f1b.../primary",
          "host": ["{{base_url}}"],
          "path": ["inventory", "664c9f1a...", "images", "664c9f1b...", "primary"],
          "variable": [
            { "key": "id", "value": "664c9f1a..." },
            { "key": "imageId", "value": "664c9f1b..." }
          ]
        }
      }
    },
    {
      "name": "Get All Categories",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{jwt_token}}", "type": "text" }
        ],
        "url": {
          "raw": "{{base_url}}/inventory/categories",
          "host": ["{{base_url}}"],
          "path": ["inventory", "categories"]
        }
      }
    },
    {
      "name": "Bulk Import from Excel",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{jwt_token}}", "type": "text" }
        ],
        "body": {
          "mode": "formdata",
          "formdata": [
            { "key": "file", "type": "file", "src": "" }
          ]
        },
        "url": {
          "raw": "{{base_url}}/inventory/import-excel",
          "host": ["{{base_url}}"],
          "path": ["inventory", "import-excel"]
        }
      }
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:5000/api/v1",
      "type": "string"
    },
    {
      "key": "jwt_token",
      "value": "your-jwt-token-here",
      "type": "string"
    }
  ]
}
