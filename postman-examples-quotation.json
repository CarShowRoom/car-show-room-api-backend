{
  "info": {
    "name": "i-max POS - Quotation API",
    "description": "Postman collection for Quotation (ယာယီ Order) — body & response same as Order API, NO stock deduction. Convert: create order via POST /order first, then PATCH /quotation/:id/convert-to-order",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "quotation-api"
  },
  "item": [
    {
      "name": "1. Create Quotation (Storefront - မူးနဲ့ရောင်း)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{jwt_token}}", "type": "text" },
          { "key": "Content-Type", "value": "application/json", "type": "text" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"saleType\": \"storefront\",\n  \"storefrontId\": \"YOUR_STOREFRONT_ID\",\n  \"customerName\": \"ဦးဘ\",\n  \"customerPhone\": \"09-123456789\",\n  \"note\": \"ဒီကိုအရင်ပို့ပေးပါ\",\n  \"ordersProducts\": [\n    {\n      \"inventoryId\": \"YOUR_INVENTORY_ID\",\n      \"unit\": \"မူး\",\n      \"quantity\": 5\n    }\n  ],\n  \"finalAmount\": 3500\n}",
          "options": {
            "raw": { "language": "json" }
          }
        },
        "url": {
          "raw": "{{base_url}}/quotation",
          "host": ["{{base_url}}"],
          "path": ["quotation"]
        }
      }
    },
    {
      "name": "2. Create Quotation (Direct-Sale - no storefront)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{jwt_token}}", "type": "text" },
          { "key": "Content-Type", "value": "application/json", "type": "text" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"saleType\": \"direct-sale\",\n  \"customerName\": \"ဦးအေး\",\n  \"customerPhone\": \"09-987654321\",\n  \"note\": \"Walk-in customer quotation\",\n  \"ordersProducts\": [\n    {\n      \"inventoryId\": \"YOUR_INVENTORY_ID\",\n      \"quantity\": 2\n    }\n  ],\n  \"finalAmount\": 14000\n}",
          "options": {
            "raw": { "language": "json" }
          }
        },
        "url": {
          "raw": "{{base_url}}/quotation",
          "host": ["{{base_url}}"],
          "path": ["quotation"]
        }
      }
    },
    {
      "name": "3. Get All Quotations",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{jwt_token}}", "type": "text" }
        ],
        "url": {
          "raw": "{{base_url}}/quotation?status=draft&page=1&limit=10",
          "host": ["{{base_url}}"],
          "path": ["quotation"],
          "query": [
            { "key": "status", "value": "draft", "description": "draft | converted | cancelled" },
            { "key": "saleType", "value": "storefront", "description": "storefront | direct-sale (optional)" },
            { "key": "page", "value": "1" },
            { "key": "limit", "value": "10" },
            { "key": "startDate", "value": "" },
            { "key": "endDate", "value": "" }
          ]
        }
      }
    },
    {
      "name": "4. Get Quotation By ID",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{jwt_token}}", "type": "text" }
        ],
        "url": {
          "raw": "{{base_url}}/quotation/QUOTATION_ID",
          "host": ["{{base_url}}"],
          "path": ["quotation", "QUOTATION_ID"],
          "variable": [
            { "key": "id", "value": "QUOTATION_ID" }
          ]
        }
      }
    },
    {
      "name": "5. Update Quotation",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Authorization", "value": "Bearer {{jwt_token}}", "type": "text" },
          { "key": "Content-Type", "value": "application/json", "type": "text" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customerName\": \"ဦးဘကြီး\",\n  \"customerPhone\": \"09-111222333\",\n  \"note\": \"Updated note\",\n  \"finalAmount\": 4000\n}",
          "options": {
            "raw": { "language": "json" }
          }
        },
        "url": {
          "raw": "{{base_url}}/quotation/QUOTATION_ID",
          "host": ["{{base_url}}"],
          "path": ["quotation", "QUOTATION_ID"],
          "variable": [
            { "key": "id", "value": "QUOTATION_ID" }
          ]
        }
      }
    },
    {
      "name": "6. Delete Quotation",
      "request": {
        "method": "DELETE",
        "header": [
          { "key": "Authorization", "value": "Bearer {{jwt_token}}", "type": "text" }
        ],
        "url": {
          "raw": "{{base_url}}/quotation/QUOTATION_ID",
          "host": ["{{base_url}}"],
          "path": ["quotation", "QUOTATION_ID"],
          "variable": [
            { "key": "id", "value": "QUOTATION_ID" }
          ]
        }
      }
    },
    {
      "name": "7. Mark Quotation as Converted (after POST /order)",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Authorization", "value": "Bearer {{jwt_token}}", "type": "text" },
          { "key": "Content-Type", "value": "application/json", "type": "text" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"convertedOrderId\": \"ORDER_ID_FROM_POST_ORDER\"\n}",
          "options": {
            "raw": { "language": "json" }
          }
        },
        "url": {
          "raw": "{{base_url}}/quotation/QUOTATION_ID/convert-to-order",
          "host": ["{{base_url}}"],
          "path": ["quotation", "QUOTATION_ID", "convert-to-order"],
          "variable": [
            { "key": "id", "value": "QUOTATION_ID" }
          ]
        }
      }
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:5000/api/v1",
      "type": "string"
    },
    {
      "key": "jwt_token",
      "value": "your-jwt-token-here",
      "type": "string"
    }
  ]
}
